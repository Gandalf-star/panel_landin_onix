# =====================================================================
#  Panel admin · Reto 50 Onix
#  Copia este archivo a .env y completa con los datos del proyecto
#  Supabase de la landing (Project Settings -> API).
#  Solo la clave publica (anon). Nunca la service_role key.
# =====================================================================

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# Cada cuantos segundos se consultan reclamos nuevos (ademas de Realtime).
SEGUNDOS_SONDEO=15
